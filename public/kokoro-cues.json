  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 3.125,
      "startFrame": 4,
      "endFrame": 94,
      "text": "In this town, every single kid goes to Graceland School."
    },
    "b2": {
      "startSec": 3.205,
      "endSec": 5.884,
      "startFrame": 96,
      "endFrame": 177,
      "text": "And there is only one rule: do your homework every night."
    },
    "b3": {
      "startSec": 5.964,
      "endSec": 8.19,
      "startFrame": 179,
      "endFrame": 246,
      "text": "Because the kids who don't... are gone by morning."
    },
    "b4": {
      "startSec": 8.31,
      "endSec": 11.388,
      "startFrame": 249,
      "endFrame": 342,
      "text": "Nobody knows who takes them. We call it the Homework Monster."
    },
    "b5": {
      "startSec": 11.488,
      "endSec": 14.903,
      "startFrame": 345,
      "endFrame": 447,
      "text": "Last week, my best friend Sam skipped his. His desk is still empty."
    },
    "b6": {
      "startSec": 15.043,
      "endSec": 16.853,
      "startFrame": 451,
      "endFrame": 506,
      "text": "And last night... I forgot mine too."
    },
    "b7": {
      "startSec": 17.053,
      "endSec": 19.392,
      "startFrame": 512,
      "endFrame": 582,
      "text": "At midnight, something scratched at my bedroom window."
    },
    "b8": {
      "startSec": 19.472,
      "endSec": 21.889,
      "startFrame": 584,
      "endFrame": 657,
      "text": "A shadow rose up in the corner, taller than the door."
    },
    "b9": {
      "startSec": 21.989,
      "endSec": 24.161,
      "startFrame": 660,
      "endFrame": 725,
      "text": "It leaned down close... and whispered my name."
    },
    "w1": {
      "startSec": 24.301,
      "endSec": 25.027,
      "startFrame": 729,
      "endFrame": 751,
      "text": "MISTER!"
    },
    "w2": {
      "startSec": 25.127,
      "endSec": 25.864,
      "startFrame": 754,
      "endFrame": 776,
      "text": "MUANA!"
    },
    "b10": {
      "startSec": 26.024,
      "endSec": 29.375,
      "startFrame": 781,
      "endFrame": 881,
      "text": "The mask slipped off. The Homework Monster was Mister K. Muana."
    },
    "b11": {
      "startSec": 29.575,
      "endSec": 32.438,
      "startFrame": 887,
      "endFrame": 973,
      "text": "But then my door opened, and every missing kid walked in."
    },
    "b12": {
      "startSec": 32.558,
      "endSec": 34.914,
      "startFrame": 977,
      "endFrame": 1047,
      "text": "They were never gone. They had been waiting for tonight."
    },
    "b13": {
      "startSec": 35.034,
      "endSec": 37.817,
      "startFrame": 1051,
      "endFrame": 1134,
      "text": "Together, we froze him solid in the Graceland schoolyard."
    },
    "b14": {
      "startSec": 37.937,
      "endSec": 40.903,
      "startFrame": 1138,
      "endFrame": 1227,
      "text": "Now he is our statue... and homework is never late again."
    }
  },
